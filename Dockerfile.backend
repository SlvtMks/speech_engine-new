FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg git build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt

RUN pip install --upgrade pip && \
    pip install -r requirements.txt

COPY speech_engine ./speech_engine

RUN mkdir -p /app/data/tts_outputs /app/data/stt_uploads

EXPOSE 8000

CMD ["uvicorn", "speech_engine.api:app", "--host", "0.0.0.0", "--port", "8000"]

